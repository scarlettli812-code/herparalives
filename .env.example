# Alibaba Bailian (server only)
# The key is read server-side only. Inject it via .env.local (gitignored) or the
# Vercel dashboard — never commit it.
DASHSCOPE_API_KEY=
# Story model. Long story responses stream back to keep the Vercel connection
# active; bounded retries still leave time for the transparent safe fallback.
QWEN_STORY_MODEL=qwen-plus
QWEN_STRUCTURED_MODEL=qwen-plus
WAN_IMAGE_MODEL=wan2.7-image-pro
# Optional Wan 2.7 synchronous multimodal endpoint. Set the workspace-specific
# Beijing/Singapore URL recommended by Model Studio; the legacy Beijing host is
# used when this is blank.
DASHSCOPE_IMAGE_ENDPOINT=
# Optional: custom OpenAI-compatible endpoint for local mock testing. Unset to use Bailian.
LLM_BASE_URL=

# Tencent CloudBase Shanghai
CLOUDBASE_ENV_ID=
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=

# Runtime: development | staging | demo | production
APP_ENV=development
NEXT_PUBLIC_DEMO_GUEST_ENABLED=true
